# syntax=docker/dockerfile:1
# One-off migration task: applies drizzle/*.sql to DATABASE_URL, then exits.
FROM node:22.23.4-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NPM_CONFIG_UPDATE_NOTIFIER=false
# Only what drizzle-kit migrate needs, pinned to the versions in pnpm-lock.yaml.
RUN npm install --no-save --no-audit --no-fund drizzle-kit@0.31.10 drizzle-orm@0.45.2 pg@8.23.0 \
  && chown -R node:node /app
COPY --chown=node:node drizzle.config.ts ./
COPY --chown=node:node drizzle ./drizzle
USER node
# drizzle.config.ts falls back to a placeholder URL; fail fast instead of hiding a missing setting.
CMD ["sh", "-c", "test -n \"$DATABASE_URL\" || { echo 'DATABASE_URL is required' >&2; exit 1; }; exec npx --no-install drizzle-kit migrate"]
