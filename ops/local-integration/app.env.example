# Populate only in an ignored private directory. Never reuse production secrets.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://postgres:LOCAL_ONLY_PASSWORD@database:5432/acquire_integration_app
APP_URL=https://app.acquire-integration.test:18443
BETTER_AUTH_URL=https://app.acquire-integration.test:18443
NEXT_PUBLIC_APP_URL=https://app.acquire-integration.test:18443
BETTER_AUTH_SECRET=GENERATE_LOCAL_ONLY
APP_READINESS_SECRET=GENERATE_LOCAL_ONLY
ACQUISITION_WORKFLOW_ENABLED=false
ACQUISITION_WORKFLOW_SCHEMA_READY=false
RESEARCH_ENABLED=false
# Provider credentials remain absent. Enable only a separately authorized test.
# Hosted-demo registration/keys/bindings must reference the simulator owner's
# exact handed-off local endpoint; do not reuse production registrations.

# Runtime starts with all execution disabled until schema, fixtures, callback,
# local simulator registration and readiness are verified.
AGENT_BACKGROUND_WORKER_ENABLED=false
AGENT_MODE_EXPLORATION_ENABLED=false
AGENT_DURABLE_STATE_ENABLED=false
AGENT_NATIVE_EXECUTION_ENABLED=false
AGENT_WORKER_SCOPE_MODE=registered
AGENT_WORKER_REQUIRE_MANDATE_SCOPE=true
CAMPAIGN_N8N_ENABLED=false
# Enable the registered worker only after setting a newly generated secret and
# exact local runtime ID. Do not set AGENT_WORKER_MANDATE_ID.
