# Operator provisioned production values only. Never copy local accounts or keys.
# Put in a private .env.production mode 0600 on the approved host.
COMMUNICATIONS_RUNTIME_ENABLED=true
DATABASE_URL=
DATABASE_SSL_CA_BASE64=
COMMUNICATIONS_DATABASE_URL=
COMMUNICATIONS_APPLICATION_ID=acquire
COMMUNICATIONS_INTEGRATION_ID=
COMMUNICATIONS_PROVIDER_CONFIGURATION_REFERENCE=
COMMUNICATIONS_SUBSCRIBER_ID=acquire-replies
COMMUNICATIONS_SERVICE_URL=
UNIPILE_API_URL=
UNIPILE_API_KEY=
COMMUNICATIONS_SCOPED_AUTH_KEY=
COMMUNICATIONS_SETUP_CALLBACK_KEY=
COMMUNICATIONS_WEBHOOK_SECRET=
COMMUNICATIONS_ACTIVE_KEY_VERSION=
COMMUNICATIONS_KEYRING_JSON=
COMMUNICATIONS_IDENTITY_KEY=
COMMUNICATIONS_IDENTITY_KEY_VERSION=
ACQUIRE_COMMUNICATIONS_ACTIVE_KEY_VERSION=
ACQUIRE_COMMUNICATIONS_KEYRING_JSON=
COMMUNICATIONS_REDIRECT_ORIGIN=
COMMUNICATIONS_SETUP_NOTIFY_URL=
COMMUNICATIONS_SETUP_SUCCESS_PATH=/settings?setup=returned
COMMUNICATIONS_SETUP_FAILURE_PATH=/settings?setup=failed
# No send capacity until the operator approves activation and backlog coverage.
COMMUNICATIONS_ACCOUNT_HOURLY_LIMIT=0
COMMUNICATIONS_ACCOUNT_DAILY_LIMIT=0
COMMUNICATIONS_APPLICATION_HOURLY_LIMIT=0
COMMUNICATIONS_APPLICATION_DAILY_LIMIT=0
