DATABASE_URL=postgresql://REPLACE_WITH_SUPABASE_SERVER_CONNECTION
WHATSAPP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
WHATSAPP_SERVICE_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_SECRET
# Enable only after approved migration 0016 has been applied.
CAMPAIGN_REPLY_MONITOR_ENABLED=false
# Trust the Supabase server's certificate with the project's CA PEM.
DATABASE_SSL_CA=REPLACE_WITH_CA_PEM
