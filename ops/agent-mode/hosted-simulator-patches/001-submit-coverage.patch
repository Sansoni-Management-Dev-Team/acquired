+/** Caller retains its tenant history turn through final dispatch admission. */
+export async function prepareHostedSubmitCoverage<T>(scopes:readonly T[],refresh:(scope:T)=>Promise<void>,project:(scope:T)=>Promise<string>){
+ let revision:string|undefined;
+ for(const scope of scopes)await refresh(scope);
+ for(const scope of scopes){const current=await project(scope);if(revision!==undefined&&revision!==current)throw Error('Hosted submit coverage changed');revision=current;}
+ if(revision===undefined)throw Error('Hosted submit coverage unavailable');
+}
