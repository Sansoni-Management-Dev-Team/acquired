+import {expect,it,vi} from 'vitest';
+import {prepareHostedSubmitCoverage} from './hosted-submit-coverage';
+it('refreshes every exact scope before projecting the final shared revision',async()=>{
+ let revision=10;const scopes=['email','whatsapp','linkedin'],projected:number[]=[],calls:string[]=[];
+ await prepareHostedSubmitCoverage(scopes,async scope=>{calls.push('refresh:'+scope);revision++;},async scope=>{calls.push('project:'+scope);projected.push(revision);return String(revision);});
+ expect(projected).toEqual([13,13,13]);expect(calls).toEqual(scopes.map(s=>'refresh:'+s).concat(scopes.map(s=>'project:'+s)));
+});
+it('refuses a changed revision during projection and does not return to dispatch',async()=>{const refresh=vi.fn(async()=>{}),project=vi.fn().mockResolvedValueOnce('13').mockResolvedValueOnce('14');await expect(prepareHostedSubmitCoverage(['a','b','c'],refresh,project)).rejects.toThrow('changed');expect(project).toHaveBeenCalledTimes(2);});
+it('does not project or submit after any refresh fails',async()=>{const refresh=vi.fn().mockResolvedValueOnce(undefined).mockRejectedValueOnce(Error('incomplete')),project=vi.fn();await expect(prepareHostedSubmitCoverage(['a','b'],refresh,project)).rejects.toThrow('incomplete');expect(project).not.toHaveBeenCalled();});
+it('rejects empty coverage and preserves projection failures',async()=>{await expect(prepareHostedSubmitCoverage([],vi.fn(),vi.fn())).rejects.toThrow('unavailable');await expect(prepareHostedSubmitCoverage(['a'],async()=>{},async()=>{throw Error('revoked');})).rejects.toThrow('revoked');});
