# Generate separate hosting keys; never copy the local account state.
LINKEDIN_SERVICE_SECRET=replace-with-random-64-character-hex
# Requires verified captured conversation/message read queries and pagination.
LINKEDIN_REPLY_MONITOR_ENABLED=false
LINKEDIN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Optional read-only agent model configuration.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
