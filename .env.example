# Database migrations must only be run after explicit approval.
# Local development defaults. Production uses postgres with the Supabase pooler URL.
DATABASE_DRIVER=postgres
DATABASE_URL=postgresql://project_acquire:project_acquire@127.0.0.1:5434/project_acquire
# Production: Supabase CA certificate PEM, supplied as a multiline server-only value.
DATABASE_SSL_CA=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM="Acquired <noreply@example.com>"
TOKEN_ENCRYPTION_KEY=
INBOUND_REPLY_SECRET=
INBOUND_WEBHOOK_SECRET=
OUTREACH_WORKER_SECRET=
CAMPAIGN_N8N_ENABLED=false
CAMPAIGN_N8N_URL=
CAMPAIGN_N8N_API_KEY=
CAMPAIGN_N8N_WORKER_CREDENTIAL_ID=
CAMPAIGN_N8N_WORKER_CREDENTIAL_NAME=Header Auth account
CAMPAIGN_APP_URL=
# Local no-send tests only; compressed Wait nodes for end-to-end checks.
CAMPAIGN_TEST_FAST_WAITS=false
REPLY_DOMAIN=
NEON_PROJECT_ID=
NEON_ORG_ID=
FIRMABLE_API_KEY=
FIRMABLE_BASE_URL=https://api.firmable.com
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
# Use fixture locally. Set live explicitly only for controlled provider testing.
TARGET_DATA_PROVIDER=fixture
OUTREACH_DRAFTING_PROVIDER=fixture
# openrouter-free shares the research free-only waterfall; ignores OUTREACH_AI_MODELS.
AI_PROVIDER=openrouter-free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Hard-capped waterfall: two free smoke-test models, then a low-cost paid fallback.
OUTREACH_AI_MODELS=z-ai/glm-5.2:free,dots-studio/dots-3-note-preview:free,qwen/qwen3.8-flash
AI_VERBOSE_LOGGING=false
TARGET_SEARCH_VERBOSE_LOGGING=false
TARGET_SEARCH_COOLDOWN_MS=3000
APOLLO_API_KEY=

# Gmail delegated sending is separate from product authentication.
APP_URL=http://localhost:3010
NEXT_PUBLIC_APP_URL=http://localhost:3010
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3010/api/mailbox/google/callback
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=

# Public website research (enable only after approved migration 0004).
RESEARCH_ENABLED=false
RESEARCH_WORKER_URL=
RESEARCH_SERVICE_SECRET=
# Public web discovery uses the authenticated Cloudflare research worker /search endpoint.
OPENAI_API_KEY=
# Optional modular Cloudflare session transport (instead of the public API key).
# FIRMABLE_TRANSPORT=cloudflare-session
# FIRMABLE_SERVICE_URL=https://acquire-research.mlai-530.workers.dev/firmable
# FIRMABLE_SERVICE_SECRET=<dedicated Worker service secret>

# LinkedIn sequence publishing/runtime (off by default; see services/linkedin/README.md).
CAMPAIGN_LINKEDIN_ENABLED=false
