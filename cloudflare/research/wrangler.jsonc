{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "acquire-research",
  "account_id": "53019d98ec6f1d1d93112558076ee677",
  "main": "index.ts",
  "compatibility_date": "2026-09-08",
  "ai": { "binding": "AI" },
  "workflows": [
    { "name": "acquire-research", "binding": "RESEARCH", "class_name": "AcquireResearch" },
    { "name": "acquire-firmable-refresh", "binding": "FIRMABLE", "class_name": "FirmableRefresh" }
  ],
  "durable_objects": { "bindings": [{ "name": "PROVIDER_COORDINATOR", "class_name": "ProviderCoordinator" }] },
  "exports": { "ProviderCoordinator": { "type": "durable-object", "storage": "sqlite" } },
  "vars": { "APP_ORIGIN": "https://acquire.mlai.au" },
  "triggers": { "crons": ["*/1 * * * *"] },
  "observability": { "enabled": true }
}
