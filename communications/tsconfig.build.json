{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "packages/**/src/**/*.ts", "services/**/src/**/*.ts"],
  "exclude": ["**/*.test.ts", "dist", "node_modules"]
}
